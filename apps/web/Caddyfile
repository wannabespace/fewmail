{
	admin off
	auto_https off
}

:{$PORT:4173} {
	root * /srv
	encode zstd gzip

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Railway's healthcheck: this deployment goes live only once the API runs the same commit, so a new web never talks to an old API.
	handle /health {
		rewrite * /health/{$RAILWAY_GIT_COMMIT_SHA}
		reverse_proxy {$API_URL} {
			header_up Host {upstream_hostport}
			# Cloudflare answers a forwarded visitor IP with error 1000 (403).
			header_up -CF-Connecting-IP
		}
	}

	# Link previews: social apps do not run the SPA, so a shared Wrapped link sends their crawlers to the API's preview page (tags and a drawn image); people still get the app.
	@shareCrawler {
		path /w/*
		header_regexp User-Agent (?i)(bot|crawl|spider|preview|facebookexternalhit|slack|discord|telegram|whatsapp|twitter|linkedin|embedly|skype|vkshare|pinterest)
	}
	handle @shareCrawler {
		rewrite * /og{path}
		reverse_proxy {$API_URL} {
			header_up Host {upstream_hostport}
			header_up -CF-Connecting-IP
		}
	}

	# A missing asset is a 404, never the app shell: a stale chunk must fail loudly, not parse HTML as JS.
	handle /assets/* {
		file_server
	}

	# A public page is `<path>/index.html` (emitted by the fewmail-seo plugin); every other route is the noindex app shell.
	handle {
		try_files {path}/index.html {path} /app.html
		file_server
	}
}
