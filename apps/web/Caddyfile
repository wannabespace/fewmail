{
	admin off
	auto_https off
}

:{$PORT:4173} {
	root * /srv
	encode zstd gzip

	# The mail frame (`srcDoc`) inherits this policy: mail needs inline styles and remote images and fonts, which the frame's own policy blocks until the user allows them. The script hashes are the prerendered pages' inline scripts; the build fails when one is missing (`vite.config.ts`). `ipc:` is the desktop app's bridge.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-site
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-ImE49Vcdt5QqO7Rd6XR69o3xxm53oGQ3gqgkFkFAJFY=' 'sha256-/Ahd9+SC1fqxnhfqq3+QrbuKchjWV9duL70hYJPwZgc=' https://e.fewmail.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; media-src 'self' blob: {$API_URL}; connect-src 'self' {$API_URL} https://e.fewmail.app ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Railway's healthcheck: this deployment goes live only once the API runs the same commit, so a new web never talks to an old API.
	handle /health {
		rewrite * /health/{$RAILWAY_GIT_COMMIT_SHA}
		reverse_proxy {$API_URL} {
			header_up Host {upstream_hostport}
			# Cloudflare answers a forwarded visitor IP with error 1000 (403).
			header_up -CF-Connecting-IP
		}
	}

	# Link previews: social apps do not run the SPA, so a shared Wrapped link sends their crawlers to the API's preview page (tags and a drawn image); people still get the app.
	@shareCrawler {
		path /w/*
		header_regexp User-Agent (?i)(bot|crawl|spider|preview|facebookexternalhit|slack|discord|telegram|whatsapp|twitter|linkedin|embedly|skype|vkshare|pinterest)
	}
	handle @shareCrawler {
		rewrite * /og{path}
		reverse_proxy {$API_URL} {
			header_up Host {upstream_hostport}
			header_up -CF-Connecting-IP
		}
	}

	# A public page opens in the visitor's language: the one they picked (the `fewmail.locale` cookie the app writes), else their browser's first. English stays unprefixed; crawlers send neither, so they reach every language through hreflang. Keep the paths in step with LOCALIZED_PATHS in `src/lib/seo.ts`.
	@pickedLanguage {
		path / /pricing /compare /compare/* /mcp /ai-email-assistant /login
		header_regexp picked Cookie (?:^|;\s*)fewmail\.locale=%22(de|es|fr|hi|id|it|ja|ko|nl|pl|pt|tr|uk|zh)%22
	}
	redir @pickedLanguage /{re.picked.1}{uri} 302

	@browserLanguage {
		path / /pricing /compare /compare/* /mcp /ai-email-assistant /login
		not header Cookie *fewmail.locale=*
		header_regexp browser Accept-Language (?i)^\s*(de|es|fr|hi|id|it|ja|ko|nl|pl|pt|tr|uk|zh)(?:[-;,]|$)
	}
	redir @browserLanguage /{re.browser.1}{uri} 302

	# A missing asset is a 404, never the app shell: a stale chunk must fail loudly, not parse HTML as JS.
	handle /assets/* {
		file_server
	}

	# A public page is `<path>/index.html` (emitted by the fewmail-seo plugin); every other route is the noindex app shell.
	handle {
		try_files {path}/index.html {path} /app.html
		file_server
	}
}
