{
	admin off
	auto_https off
}

:{$PORT:4173} {
	root * /srv
	encode zstd gzip

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Railway's healthcheck: this deployment goes live only once the API runs the same commit, so a new web never talks to an old API.
	handle /health {
		rewrite * /health/{$RAILWAY_GIT_COMMIT_SHA}
		reverse_proxy {$API_URL} {
			header_up Host {upstream_hostport}
		}
	}

	# A missing asset is a 404, never the app shell: a stale chunk must fail loudly, not parse HTML as JS.
	handle /assets/* {
		file_server
	}

	# A public page is `<path>/index.html` (emitted by the fewmail-seo plugin); every other route is the noindex app shell.
	handle {
		try_files {path}/index.html {path} /app.html
		file_server
	}
}
