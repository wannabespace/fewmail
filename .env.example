DATABASE_URL=postgres://postgres:postgres@localhost:5433/fewmail
# openssl rand -hex 32
ENCRYPTION_SECRET=
BETTER_AUTH_SECRET=
# Google Cloud console → OAuth client (Web). Redirect URI: https://api.local.fewmail.app/auth/callback/google (prod: https://api.fewmail.app/auth/callback/google)
# Enable the Gmail API and add yourself as a test user on the consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Gmail push, so mail and read/archive changes arrive in seconds (without it the worker polls every 2 minutes).
# Pub/Sub topic with gmail-api-push@system.gserviceaccount.com as Publisher, and a push subscription to
# https://api.fewmail.app/gmail/push with authentication on, signed as GMAIL_PUSH_SERVICE_ACCOUNT (audience = the endpoint URL).
# Production values are in .railway/railway.ts; locally Google cannot reach the API, so leave them empty.
GMAIL_PUSH_TOPIC=
GMAIL_PUSH_SERVICE_ACCOUNT=
OPENROUTER_API_KEY=
# Optional: @BotFather token. Without TELEGRAM_WEBHOOK_SECRET the bot long-polls (dev).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Optional: WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp). Webhook: https://api.fewmail.app/whatsapp,
# verify token = WHATSAPP_VERIFY_TOKEN, subscribe to "messages". WHATSAPP_NUMBER is the bot's number in digits only (for wa.me links).
# WHATSAPP_TEMPLATE: an approved Utility template (language en) with one body variable and one Quick Reply button, used outside the 24 h window.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=
# Optional: browser notifications (Web Push). Generate once with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Stripe (Pro, $15/month): a recurring price; webhook → https://api.fewmail.app/stripe/webhook
# for customer.subscription.created/updated/deleted. Locally: stripe listen --forward-to https://api.local.fewmail.app/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_MAX_MONTHLY_PRICE_ID=
STRIPE_MAX_YEARLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# TypeSafe Jev (fast typed decisions for every email). Without it Claude Haiku classifies.
TYPESAFE_API_KEY=
# Mistral (Codestral FIM) for inline autocomplete in the composer. Without it the fast chat model completes.
MISTRAL_API_KEY=
# Voice: Home read aloud and voice answers to voice messages (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
